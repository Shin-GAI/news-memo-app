# API server base URL for native (Android/iOS) builds
# Replace with your actual Manus sandbox URL (change 8081 → 3000)
EXPO_PUBLIC_API_BASE_URL=https://3000-REPLACE_WITH_YOUR_SANDBOX_ID.us-east5.run.app

# Google AI Studio API key (무료)
# https://aistudio.google.com/app/apikey 에서 발급
# 설정하면 Forge API 대신 Google AI Studio의 gemini-2.0-flash 를 사용합니다
GEMINI_API_KEY=여기에_구글_AI_스튜디오_API_키_입력
