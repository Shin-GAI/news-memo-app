# API server base URL for native (Android/iOS) builds
# Vercel deployment URL (auto-detected for web builds)
EXPO_PUBLIC_API_BASE_URL=https://news-memo-app.vercel.app
API_BASE_URL=https://news-memo-app.vercel.app

# Google AI Studio API key (무료)
# https://aistudio.google.com/app/apikey 에서 발급
# 설정하면 Forge API 대신 Google AI Studio API를 사용합니다
GEMINI_API_KEY=여기에_구글_AI_스튜디오_API_키_입력

# Gemini 모델명 (기본값: gemini-2.0-flash)
# 다른 모델 사용 시: gemini-2.5-flash, gemini-1.5-pro 등
# GEMINI_MODEL=gemini-2.0-flash
